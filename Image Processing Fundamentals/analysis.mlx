%% Compare edge detectors: clean vs noisy cameraman
% Question: How do smoothing and Canny sigma affect edge detection,
% especially false edges and detail loss in Gaussian noise?
% Input is MATLAB's built-in sample image cameraman.tif (not redistributed).

clear; close all; clc;

%% Load and prepare image
I = imread('cameraman.tif');
if size(I,3) == 3
    I = rgb2gray(I);
end
I = im2double(I);

%% Create reproducible noisy image
rng(42);
In = imnoise(I,'gaussian',0,0.01);

figure('Name','Input images','Color','w');
tiledlayout(1,2);
nexttile; imshow(I); title('Original cameraman.tif');
nexttile; imshow(In); title('Gaussian noise: variance 0.01');
exportgraphics(gcf,fullfile('results','input_images.png'),'Resolution',200);

%% Apply three detectors to both images
% Sobel is applied after Gaussian smoothing with sigma = 1.
E_clean_sobel = edge(imgaussfilt(I,1),'Sobel');
E_clean_canny1 = edge(I,'Canny',[],1);
E_clean_canny3 = edge(I,'Canny',[],3);

E_noisy_sobel = edge(imgaussfilt(In,1),'Sobel');
E_noisy_canny1 = edge(In,'Canny',[],1);
E_noisy_canny3 = edge(In,'Canny',[],3);

edgeMaps = {E_clean_sobel,E_clean_canny1,E_clean_canny3,...
    E_noisy_sobel,E_noisy_canny1,E_noisy_canny3};
mapTitles = {'Clean: Sobel + Gaussian sigma=1',...
    'Clean: Canny sigma=1','Clean: Canny sigma=3',...
    'Noisy: Sobel + Gaussian sigma=1',...
    'Noisy: Canny sigma=1','Noisy: Canny sigma=3'};

%% Show all six edge maps together
figure('Name','Six edge maps','Color','w');
tiledlayout(2,3,'Padding','compact','TileSpacing','compact');
for k = 1:6
    nexttile; imshow(edgeMaps{k}); title(mapTitles{k},'Interpreter','none');
end
exportgraphics(gcf,fullfile('results','six_edge_maps.png'),'Resolution',200);

%% Count edge pixels (nnz)
counts = cellfun(@nnz,edgeMaps)';
ImageType = categorical({'Clean';'Clean';'Clean';'Noisy';'Noisy';'Noisy'});
Detector = categorical({'Sobel + Gaussian';'Canny';'Canny';...
    'Sobel + Gaussian';'Canny';'Canny'});
Sigma = [1;1;3;1;1;3];
EdgePixelCount = counts;
T = table(ImageType,Detector,Sigma,EdgePixelCount);
disp(T);
writetable(T,fullfile('results','edge_pixel_counts.csv'));

%% Plot count comparison
figure('Name','Edge pixel counts','Color','w');
bar(counts); grid on;
xticklabels({'Clean Sobel','Clean Canny 1','Clean Canny 3',...
    'Noisy Sobel','Noisy Canny 1','Noisy Canny 3'});
xtickangle(25); ylabel('Number of edge pixels (nnz)');
title('Edge pixel count comparison');
exportgraphics(gcf,fullfile('results','edge_pixel_counts.png'),'Resolution',200);

%% Inspect a region (upper-left sky) for noise-related false edges
% Compare the same crop. This region is relatively smooth in the original,
% so extra edge fragments in the noisy sigma=1 result may be noise-induced.
rows = 1:150; cols = 1:150;
figure('Name','Region inspection','Color','w');
tiledlayout(2,2);
nexttile; imshow(I(rows,cols)); title('Clean crop: upper-left sky');
nexttile; imshow(In(rows,cols)); title('Noisy crop: upper-left sky');
nexttile; imshow(E_noisy_canny1(rows,cols)); title('Noisy Canny sigma=1');
nexttile; imshow(E_noisy_canny3(rows,cols)); title('Noisy Canny sigma=3');
exportgraphics(gcf,fullfile('results','region_inspection.png'),'Resolution',200);

%% Interpretation and limitation
% Canny sigma=1 preserves finer spatial detail, but on the noisy image it
% may also detect small noise fluctuations as edges. Sigma=3 smooths over
% more local variation and typically suppresses false edges; it can also
% erase weak or closely spaced real boundaries. Gaussian smoothing before
% Sobel similarly reduces noise sensitivity, with some detail loss.
% Inspect the upper-left sky crop for invented edge fragments, and inspect
% thin details (e.g., camera/tripod boundaries) for possible loss at sigma=3.
% The exact appearance/counts depend on MATLAB's implementation/defaults.
% Limitation: nnz is only a quantity, not an accuracy measure. It cannot
% distinguish true object boundaries from false detections or missed edges.

fprintf('\nConclusion: stronger smoothing (larger Canny sigma) generally reduces\n');
fprintf('noise-related edges but may remove fine detail. Edge count alone\n');
fprintf('does not establish edge-map correctness. Inspect the saved region\n');
fprintf('figure to verify the specific lost/invented edge in your run.\n');

